[Unit]
Description=Pet Feeder AI Demo Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pet-feeder-ai-demo
ExecStart=/opt/py312/bin/python -m app.main --config /opt/pet-feeder-ai-demo/configs/demo_config.yaml
Environment=PYTHONUNBUFFERED=1
User=root
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target